fill (-0.310542u,0.830125u)--(-0.346535u,0.810760u)--(-0.490356u,0.753747u)--(-0.389271u,0.687984u)--cycle withcolor polygonfill3;
fill (-0.861382u,0.036320u)--(-1.000000u,-0.025977u)--(-0.844034u,-0.005737u)--cycle withcolor polygonfill1;
fill (0.570004u,-0.553670u)--(0.477316u,-0.521571u)--(0.407240u,-0.645928u)--(0.538772u,-0.635232u)--cycle withcolor polygonfill2;
