draw (0.003144u,0.063687u)--(-0.340852u,0.260746u)--(-0.679884u,0.415283u)--(-0.389271u,0.687984u)--(-0.118889u,0.712909u)--(0.003144u,0.063687u) withpen pencircle scaled routewidth withcolor routecolor3;
