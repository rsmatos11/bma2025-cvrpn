drawdot (-0.128311u,-0.481724u) withpen pencircle scaled visitpointsize withcolor visitpoint2;
drawdot (0.007349u,-0.303341u) withpen pencircle scaled visitpointsize withcolor visitpoint2;
drawdot (0.075112u,-0.116851u) withpen pencircle scaled depotsize withcolor depotcolor;
mrg := 0.1cm;
setbounds currentpicture to (llcorner currentpicture - (mrg,mrg))--(lrcorner currentpicture + (mrg,-mrg))--(urcorner currentpicture + (mrg,mrg))--(ulcorner currentpicture + (-mrg,mrg))--cycle;
endfig;
