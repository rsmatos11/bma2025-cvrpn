draw (0.128331u,0.001131u)--(-0.192498u,-0.012532u)--(-0.597646u,0.839839u)--(-0.479922u,0.847562u)--(-0.247801u,0.524548u)--(0.128331u,0.001131u) withpen pencircle scaled routewidth withcolor routecolor3;
