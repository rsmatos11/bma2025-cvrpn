draw (-0.571402u,0.287996u)--(-0.621366u,0.371172u)--(-0.787362u,0.346250u)--(-0.637531u,0.159594u)--(-0.544464u,0.219458u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge1;
