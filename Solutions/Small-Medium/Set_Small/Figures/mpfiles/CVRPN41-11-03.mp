draw (-0.559062u,0.330064u)--(-0.514790u,0.205128u)--(-0.347647u,0.169799u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge1;
draw (-0.067389u,-0.026708u)--(0.064188u,-0.305973u)--(-0.007936u,-0.729154u)--(-0.535404u,-0.900993u)--(-0.827288u,-0.360014u)--(-0.347647u,0.169799u)--(-0.252074u,0.102787u)--(-0.067389u,-0.026708u) withpen pencircle scaled routewidth withcolor routecolor1;
draw (-0.067389u,-0.026708u)--(0.318558u,0.211430u)--(0.869312u,0.769887u)--(0.701985u,0.086426u)--(0.748370u,-0.587050u)--(0.373635u,-0.379588u)--(-0.067389u,-0.026708u) withpen pencircle scaled routewidth withcolor routecolor2;
drawdot (0.064188u,-0.305973u) withpen pencircle scaled visitpointsize withcolor visitpoint1;
drawdot (-0.007936u,-0.729154u) withpen pencircle scaled visitpointsize withcolor visitpoint1;
drawdot (-0.535404u,-0.900993u) withpen pencircle scaled visitpointsize withcolor visitpoint1;
drawdot (-0.827288u,-0.360014u) withpen pencircle scaled visitpointsize withcolor visitpoint1;
drawdot (-0.347647u,0.169799u) withpen pencircle scaled visitpointsize withcolor visitpoint1;
drawdot (-0.252074u,0.102787u) withpen pencircle scaled visitpointsize withcolor visitpoint1;
drawdot (0.318558u,0.211430u) withpen pencircle scaled visitpointsize withcolor visitpoint2;
drawdot (0.869312u,0.769887u) withpen pencircle scaled visitpointsize withcolor visitpoint2;
drawdot (0.701985u,0.086426u) withpen pencircle scaled visitpointsize withcolor visitpoint2;
drawdot (0.748370u,-0.587050u) withpen pencircle scaled visitpointsize withcolor visitpoint2;
drawdot (0.373635u,-0.379588u) withpen pencircle scaled visitpointsize withcolor visitpoint2;
drawdot (-0.067389u,-0.026708u) withpen pencircle scaled depotsize withcolor depotcolor;
mrg := 0.1cm;
setbounds currentpicture to (llcorner currentpicture - (mrg,mrg))--(lrcorner currentpicture + (mrg,-mrg))--(urcorner currentpicture + (mrg,mrg))--(ulcorner currentpicture + (-mrg,mrg))--cycle;
endfig;
end;
