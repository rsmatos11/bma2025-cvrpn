fill (-0.902660u,-0.208997u)--(-1.000000u,-0.341047u)--(-0.827288u,-0.360014u)--cycle withcolor polygonfill1;
fill (0.262105u,-0.166276u)--(0.106840u,-0.183091u)--(0.064188u,-0.305973u)--cycle withcolor polygonfill1;
fill (-0.535404u,-0.900993u)--(-0.673716u,-0.868905u)--(-0.648377u,-0.942526u)--cycle withcolor polygonfill1;
fill (-0.559062u,0.330064u)--(-0.514790u,0.205128u)--(-0.347647u,0.169799u)--cycle withcolor polygonfill1;
draw (0.748370u,-0.587050u)--(0.739634u,-0.646509u)--(0.940626u,-0.627868u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge2;
draw (1.000000u,0.942526u)--(0.869312u,0.769887u)--(0.997831u,0.836699u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge2;
draw (-0.115955u,0.230732u)--(-0.274917u,0.081315u)--(-0.123576u,0.036801u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge1;
draw (0.373635u,-0.379588u)--(0.298378u,-0.561832u)--(0.453415u,-0.499808u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge2;
draw (0.558164u,0.225723u)--(0.592595u,0.077716u)--(0.701985u,0.086426u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge2;
draw (0.508358u,0.234953u)--(0.318558u,0.211430u)--(0.449253u,0.046823u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge2;
draw (0.123283u,-0.718069u)--(-0.007936u,-0.729154u)--(0.162841u,-0.794740u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge1;
draw (-0.902660u,-0.208997u)--(-1.000000u,-0.341047u)--(-0.827288u,-0.360014u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge1;
