draw (-0.824221u,0.608490u)--(-1.000000u,0.551467u)--(-0.954699u,0.453727u)--(-0.990220u,0.411995u)--(-0.838680u,0.434296u)--cycle withpen pencircle scaled edgewidth withcolor polygonedge1;
